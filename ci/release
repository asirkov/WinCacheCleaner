#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/common"
if [[ ${GITHUB_REF:-} != refs/heads/main || ${GITHUB_EVENT_NAME:-} == pull_request ]]; then
  echo 'Release publication is permitted only from main outside pull requests.' >&2
  exit 1
fi
: "${GITHUB_REPOSITORY:?Missing GITHUB_REPOSITORY}"
: "${GITHUB_SHA:?Missing GITHUB_SHA}"
tag="v${version}"
tag_exists=false
if git ls-remote --exit-code --tags origin "refs/tags/${tag}" >/dev/null; then
  tag_exists=true
else
  status=$?
  if [[ $status -ne 2 ]]; then exit "$status"; fi
fi
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
release_exists=false
if gh api "repos/${GITHUB_REPOSITORY}/releases/tags/${tag}" --silent 2> "$scratch/api-error"; then
  release_exists=true
else
  status=$?
  # A 404 means missing release. Authentication, rate limits and network failures do not.
  if ! grep -Fq '(HTTP 404)' "$scratch/api-error"; then
    cat "$scratch/api-error" >&2
    exit "$status"
  fi
fi
target_commit=$GITHUB_SHA
if [[ $tag_exists == true ]]; then
  target_commit=$(git rev-parse --verify "refs/tags/${tag}^{commit}")
fi
RELEASE_COMMIT="$target_commit" bash "$repo_root/ci/git-notes" > "$scratch/notes.md"
if [[ $release_exists == true ]]; then
  if [[ $tag_exists != true ]]; then
    echo 'Release exists without a published tag; inspect the draft release before retrying.' >&2
    exit 1
  fi
  gh release edit "$tag" --repo "$GITHUB_REPOSITORY" --notes-file "$scratch/notes.md"
  echo "Updated ${tag} release notes from its tagged commit."
  exit 0
fi
(cd dist && sha256sum --check SHA256SUMS.txt)
# An existing tag may point to an older commit. Upload only its exact source/docs.
for file in WinCacheCleaner.ps1 README.md LICENSE VERSION; do
  if ! git show "${target_commit}:${file}" | cmp - "dist/$file"; then
    echo "Release asset differs from target commit: $file" >&2
    exit 1
  fi
done
create_options=()
if [[ $tag_exists == true ]]; then create_options+=(--verify-tag); fi
gh release create "$tag" "${create_options[@]}" \
  --repo "$GITHUB_REPOSITORY" \
  --target "$target_commit" \
  --title "WinCacheCleaner ${tag}" \
  --notes-file "$scratch/notes.md" \
  dist/WinCacheCleaner.cmd dist/WinCacheCleaner.ps1 dist/SHA256SUMS.txt "dist/WinCacheCleaner-${tag}.zip"
