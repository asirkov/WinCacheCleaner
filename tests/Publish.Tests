#!/usr/bin/env bash
# Exercise release state transitions without network access or GitHub mutations.
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixture=$(mktemp -d)
trap 'rm -rf -- "$fixture"' EXIT
mkdir -p "$fixture/ci" "$fixture/bin" "$fixture/dist"
cp "$project_root/ci/common" "$project_root/ci/release" "$project_root/ci/git-notes" "$project_root/ci/build" "$fixture/ci/"
cd -- "$fixture"
git init -q
git config user.name 'Publish test'
git config user.email 'publish-test@example.invalid'
printf '0.3.3\n' > VERSION
printf 'fixture script\n' > WinCacheCleaner.ps1
printf 'tagged documentation\n' > README.md
printf 'fixture license\n' > LICENSE
git add VERSION WinCacheCleaner.ps1 README.md LICENSE
git commit -qm 'fix: create released fixture'
released_commit=$(git rev-parse HEAD)
git tag v0.3.3
git init --bare -q "$fixture/remote.git"
git remote add origin "$fixture/remote.git"
git push -q origin HEAD:main refs/tags/v0.3.3
for file in VERSION WinCacheCleaner.ps1 README.md LICENSE; do cp "$file" dist/; done
printf 'fixture launcher\n' > dist/WinCacheCleaner.cmd
printf 'fixture archive\n' > dist/WinCacheCleaner-v0.3.3.zip
(cd dist && sha256sum --binary VERSION WinCacheCleaner.ps1 README.md LICENSE WinCacheCleaner.cmd > SHA256SUMS.txt)
printf 'later documentation\n' > README.md
git add README.md
git commit -qm 'docs: update later documentation'
# The main packaging job must recover assets from the old tag, not new branch docs.
GITHUB_REF=refs/heads/main bash ci/build "$fixture/tagged package" > "$fixture/build-output"
for file in VERSION WinCacheCleaner.ps1 README.md LICENSE; do
  git show "v0.3.3:$file" | cmp - "$fixture/tagged package/$file"
done
! grep -q 'later documentation' "$fixture/tagged package/RELEASE_NOTES.md"
cat > bin/gh <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "$TEST_CALLS"
if [[ $1 == api ]]; then
  case $TEST_RELEASE_STATE in
    present) exit 0 ;;
    missing) echo 'gh: Not Found (HTTP 404)' >&2; exit 1 ;;
    denied) echo 'gh: Resource not accessible (HTTP 403)' >&2; exit 1 ;;
  esac
fi
if [[ $1 == release && ($2 == edit || $2 == create) ]]; then
  while (( $# > 0 )); do
    if [[ $1 == --notes-file ]]; then cp "$2" "$TEST_NOTES"; break; fi
    shift
  done
  exit 0
fi
exit 99
MOCK
chmod +x bin/gh
export PATH="$fixture/bin:$PATH" TEST_CALLS="$fixture/calls" TEST_NOTES="$fixture/notes"
export GITHUB_REF=refs/heads/main GITHUB_EVENT_NAME=push GITHUB_REPOSITORY=fixture/repo
export GITHUB_SHA
GITHUB_SHA=$(git rev-parse HEAD)
export TEST_RELEASE_STATE=missing
bash ci/release > "$fixture/output"
grep -q 'release create v0.3.3 --verify-tag' "$TEST_CALLS"
grep -q -- "--target $released_commit" "$TEST_CALLS"
! grep -q 'later documentation' "$TEST_NOTES"
: > "$TEST_CALLS"
export TEST_RELEASE_STATE=present
bash ci/release > "$fixture/output"
grep -q 'release edit v0.3.3' "$TEST_CALLS"
! grep -q 'release create' "$TEST_CALLS"
! grep -q 'later documentation' "$TEST_NOTES"
: > "$TEST_CALLS"
export TEST_RELEASE_STATE=denied
if bash ci/release > "$fixture/output" 2>&1; then echo 'API denial was ignored' >&2; exit 1; fi
! grep -q 'release create\|release edit' "$TEST_CALLS"
: > "$TEST_CALLS"
export TEST_RELEASE_STATE=missing
printf 'wrong source\n' >> dist/WinCacheCleaner.ps1
(cd dist && sha256sum --binary VERSION WinCacheCleaner.ps1 README.md LICENSE WinCacheCleaner.cmd > SHA256SUMS.txt)
if bash ci/release > "$fixture/output" 2>&1; then echo 'Mismatched asset was published' >&2; exit 1; fi
! grep -q 'release create' "$TEST_CALLS"
# New tag/release creation still targets the tested branch commit.
git push -q origin :refs/tags/v0.3.3
git tag -d v0.3.3 >/dev/null
for file in VERSION WinCacheCleaner.ps1 README.md LICENSE; do cp "$file" dist/; done
(cd dist && sha256sum --binary VERSION WinCacheCleaner.ps1 README.md LICENSE WinCacheCleaner.cmd > SHA256SUMS.txt)
: > "$TEST_CALLS"
bash ci/release > "$fixture/output"
grep -q 'release create v0.3.3' "$TEST_CALLS"
! grep -q -- '--verify-tag' "$TEST_CALLS"
grep -q -- "--target $GITHUB_SHA" "$TEST_CALLS"
: > "$TEST_CALLS"
if GITHUB_REF=refs/heads/develop bash ci/release > "$fixture/output" 2>&1; then echo 'Develop was published' >&2; exit 1; fi
[[ ! -s $TEST_CALLS ]]
printf 'PASS: exact-tag packaging, tag-only recovery, existing release, new release, API denial, asset identity, develop guard\n'
